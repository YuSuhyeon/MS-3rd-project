import os
import spotipy
from spotipy.oauth2 import SpotifyOAuth
import random
from typing import List, Dict, Any

# 플레이리스트 생성을 위한 권한 범위(scope) - Audio Features 접근 권한 추가
SCOPE = "playlist-modify-public playlist-modify-private user-read-private user-top-read"

class SpotifyService:
    def __init__(self):
        self.sp_oauth = SpotifyOAuth(
            client_id=os.getenv("SPOTIFY_CLIENT_ID"),
            client_secret=os.getenv("SPOTIFY_CLIENT_SECRET"),
            redirect_uri=os.getenv("SPOTIFY_REDIRECT_URI", 'http://127.0.0.1:5000/api/spotify/callback'),
            scope=SCOPE
        )

#인증 URL 생성
    def get_auth_url(self):
    
        return self.sp_oauth.get_authorize_url()
#토큰 발급
    def get_token_info(self, auth_code):
        return self.sp_oauth.get_access_token(auth_code)

#토큰 유효성 검증
    def is_token_valid(self, token_info):
        return self.sp_oauth.is_token_expired(token_info) == False
    
    def get_valid_spotify_client(self, token_info):
        """유효한 Spotify 클라이언트를 반환합니다."""
        try:
            # 토큰이 만료되었는지 확인하고 갱신
            if self.sp_oauth.is_token_expired(token_info):
                token_info = self.sp_oauth.refresh_access_token(token_info['refresh_token'])
                # 세션 업데이트는 호출하는 곳에서 처리
            
            return spotipy.Spotify(auth=token_info['access_token']), token_info
        except Exception as e:
            print(f"토큰 갱신 오류: {e}")
            return None, None

    def get_current_user(self, token_info):
        """현재 사용자 정보를 가져옵니다."""
        try:
            sp, updated_token = self.get_valid_spotify_client(token_info)
            if not sp:
                return {'success': False, 'error': 'Invalid token'}
            
            user_profile = sp.current_user()
            return {
                'success': True,
                'user': user_profile,
                'updated_token': updated_token
            }
        except Exception as e:
            return {'success': False, 'error': str(e)}    

    def create_playlist_for_user(self, token_info, playlist_name, track_names, description=""):
        """
        인증된 사용자를 위해 플레이리스트를 생성하고 트랙을 추가합니다.
        
        :param token_info: 인증을 통해 발급받은 토큰 정보 딕셔너리
        :param playlist_name: 생성할 플레이리스트 이름
        :param track_names: 추가할 트랙 이름의 리스트
        :param description: 플레이리스트 설명
        :return: 생성 결과 (성공 시 플레이리스트 정보, 실패 시 에러 메시지)
        """
        # 토큰 만료 시 자동 갱신을 포함한 spotipy 클라이언트 생성
        sp = spotipy.Spotify(oauth_manager=self.sp_oauth)
        
        try:
            # 1. 사용자 정보 가져오기
            user_id = sp.current_user()['id']

            # 2. 트랙 이름으로 트랙 URI 검색
            track_uris = self._search_tracks(sp, track_names)
            if not track_uris:
                return {'success': False, 'error': 'No valid tracks found'}

            # 3. 플레이리스트 생성
            playlist = sp.user_playlist_create(
                user=user_id,
                name=playlist_name,
                public=False,  # 기본적으로 비공개로 생성
                description=description
            )
            playlist_id = playlist['id']

            # 4. 플레이리스트에 트랙 추가 (최대 100개씩)
            sp.playlist_add_items(playlist_id, track_uris)

            return {
                'success': True,
                'playlist_id': playlist_id,
                'playlist_url': playlist['external_urls']['spotify'],
                'message': f"'{playlist_name}' playlist created successfully."
            }
        except Exception as e:
            return {'success': False, 'error': str(e)}

    def _search_tracks(self, sp_client, track_names):
        """헬퍼 함수: 트랙 이름 목록을 Spotify 트랙 URI 목록으로 변환합니다."""
        uris = []
        for name in track_names:
            try:
                results = sp_client.search(q=f'track:{name}', type='track', limit=1)
                if results['tracks']['items']:
                    uris.append(results['tracks']['items'][0]['uri'])
            except Exception:
                # 검색 실패 시 해당 트랙은 건너뜀
                continue
        return uris

    def search_tracks_by_features(self, token_info: dict, artists: List[str], 
                                 audio_features: Dict[str, Any], limit: int = 20) -> dict:
        """
        Audio Features를 기반으로 K-pop 트랙을 검색합니다.
        
        :param token_info: 인증 토큰 정보
        :param artists: 선택된 아티스트 목록
        :param audio_features: 원하는 Audio Features 범위
        :param limit: 검색할 트랙 수
        :return: 검색 결과
        """
        sp = spotipy.Spotify(oauth_manager=self.sp_oauth)
        
        try:
            found_tracks = []
            
            # 1. 아티스트별 검색 (아티스트가 선택된 경우)
            if artists:
                for artist in artists:
                    if len(found_tracks) >= limit:
                        break
                        
                    # 각 아티스트의 인기 트랙 가져오기
                    search_results = sp.search(
                        q=f'artist:{artist} genre:k-pop', 
                        type='track', 
                        limit=50
                    )
                    
                    tracks = search_results['tracks']['items']
                    
                    # 각 트랙의 Audio Features 확인
                    for track in tracks:
                        if len(found_tracks) >= limit:
                            break
                            
                        track_id = track['id']
                        try:
                            features = sp.audio_features([track_id])[0]
                            
                            if features and self._matches_criteria(features, audio_features):
                                found_tracks.append({
                                    'id': track_id,
                                    'name': track['name'],
                                    'artist': track['artists'][0]['name'],
                                    'uri': track['uri'],
                                    'popularity': track['popularity'],
                                    'features': features
                                })
                        except Exception as e:
                            print(f"Audio Features 가져오기 오류 (트랙 ID: {track_id}): {e}")
                            continue
            
            # 2. 일반 K-pop 검색 (아티스트가 선택되지 않은 경우 또는 부족한 경우)
            if len(found_tracks) < limit:
                # K-pop 관련 검색어들
                kpop_queries = [
                    'genre:k-pop', 'korean pop', 'kpop', 'korean music',
                    'genre:"korean pop"', 'market:KR'
                ]
                
                for query in kpop_queries:
                    if len(found_tracks) >= limit:
                        break
                        
                    try:
                        search_results = sp.search(
                            q=query,
                            type='track',
                            limit=50,
                            market='KR'
                        )
                        
                        tracks = search_results['tracks']['items']
                        
                        for track in tracks:
                            if len(found_tracks) >= limit:
                                break
                                
                            # 이미 추가된 트랙 제외
                            if any(t['id'] == track['id'] for t in found_tracks):
                                continue
                                
                            track_id = track['id']
                            try:
                                features = sp.audio_features([track_id])[0]
                                
                                if features and self._matches_criteria(features, audio_features):
                                    found_tracks.append({
                                        'id': track_id,
                                        'name': track['name'],
                                        'artist': track['artists'][0]['name'],
                                        'uri': track['uri'],
                                        'popularity': track['popularity'],
                                        'features': features
                                    })
                            except Exception as e:
                                print(f"Audio Features 가져오기 오류 (트랙 ID: {track_id}): {e}")
                                continue
                    except Exception as e:
                        print(f"검색 오류 (쿼리: {query}): {e}")
                        continue
            
            # 3. Spotify 추천 API 사용 (추가 트랙이 필요한 경우)
            if len(found_tracks) < limit and found_tracks:
                try:
                    # 찾은 트랙들을 시드로 사용하여 추천받기
                    seed_tracks = random.sample(found_tracks, min(5, len(found_tracks)))
                    seed_track_ids = [track['id'] for track in seed_tracks]
                    
                    # Audio Features 평균값 계산
                    target_features = self._calculate_target_features(audio_features)
                    
                    recommendations = sp.recommendations(
                        seed_tracks=seed_track_ids[:5],  # 최대 5개
                        limit=min(limit - len(found_tracks), 20),  # API 제한 고려
                        market='KR',
                        **target_features
                    )
                    
                    for track in recommendations['tracks']:
                        if len(found_tracks) >= limit:
                            break
                            
                        # 이미 추가된 트랙 제외
                        if any(t['id'] == track['id'] for t in found_tracks):
                            continue
                        
                        track_id = track['id']
                        try:
                            features = sp.audio_features([track_id])[0]
                            
                            if features:
                                found_tracks.append({
                                    'id': track_id,
                                    'name': track['name'],
                                    'artist': track['artists'][0]['name'],
                                    'uri': track['uri'],
                                    'popularity': track['popularity'],
                                    'features': features
                                })
                        except Exception as e:
                            print(f"추천 트랙 Audio Features 가져오기 오류: {e}")
                            continue
                
                except Exception as e:
                    print(f"추천 API 오류: {e}")
            
            # 인기도 순으로 정렬
            found_tracks.sort(key=lambda x: x['popularity'], reverse=True)
            
            return {
                'success': True,
                'tracks': found_tracks[:limit],
                'total_found': len(found_tracks)
            }
            
        except Exception as e:
            return {'success': False, 'error': str(e)}

    def _matches_criteria(self, features: dict, criteria: Dict[str, Any]) -> bool:
        """
        트랙의 Audio Features가 주어진 기준에 맞는지 확인합니다.
        """
        if not features:
            return False
            
        for feature_name, range_values in criteria.items():
            if feature_name not in features:
                continue
                
            feature_value = features[feature_name]
            if feature_value is None:
                continue
                
            # 범위 값이 리스트인 경우 [min, max]
            if isinstance(range_values, list) and len(range_values) == 2:
                min_val, max_val = range_values
                if not (min_val <= feature_value <= max_val):
                    return False
            # 단일 값인 경우 (tempo 등)
            elif isinstance(range_values, (int, float)):
                # tempo의 경우 ±20 BPM 허용
                if feature_name == 'tempo':
                    if not (range_values - 20 <= feature_value <= range_values + 20):
                        return False
                else:
                    # 다른 특성은 ±0.1 허용
                    if not (range_values - 0.1 <= feature_value <= range_values + 0.1):
                        return False
        
        return True

    def _calculate_target_features(self, audio_features: Dict[str, Any]) -> dict:
        """
        Spotify 추천 API용 타겟 Features 계산
        """
        target = {}
        
        for feature_name, range_values in audio_features.items():
            if isinstance(range_values, list) and len(range_values) == 2:
                # 범위의 중간값 사용
                target[f'target_{feature_name}'] = (range_values[0] + range_values[1]) / 2
            elif isinstance(range_values, (int, float)):
                target[f'target_{feature_name}'] = range_values
        
        return target

    def get_track_audio_features(self, token_info: dict, track_id: str) -> dict:
        """
        특정 트랙의 Audio Features를 가져옵니다.
        """
        sp = spotipy.Spotify(oauth_manager=self.sp_oauth)
        
        try:
            features = sp.audio_features([track_id])[0]
            track_info = sp.track(track_id)
            
            return {
                'success': True,
                'track': {
                    'id': track_id,
                    'name': track_info['name'],
                    'artist': track_info['artists'][0]['name'],
                    'features': features
                }
            }
            
        except Exception as e:
            return {'success': False, 'error': str(e)}

    def get_recommendations_by_features(self, token_info: dict, seed_artists: List[str] = None,
                                       seed_tracks: List[str] = None, target_features: Dict[str, float] = None,
                                       limit: int = 20) -> dict:
        """
        Audio Features를 기반으로 추천 트랙을 가져옵니다.
        """
        sp = spotipy.Spotify(oauth_manager=self.sp_oauth)
        
        try:
            # 아티스트 이름을 ID로 변환
            seed_artist_ids = []
            if seed_artists:
                for artist_name in seed_artists[:5]:  # 최대 5개
                    try:
                        search_result = sp.search(q=f'artist:{artist_name}', type='artist', limit=1)
                        if search_result['artists']['items']:
                            seed_artist_ids.append(search_result['artists']['items'][0]['id'])
                    except Exception as e:
                        print(f"아티스트 검색 오류 ({artist_name}): {e}")
                        continue
            
            # 추천 매개변수 설정
            recommendation_params = {
                'limit': min(limit, 100),  # API 제한
                'market': 'KR'
            }
            
            if seed_artist_ids:
                recommendation_params['seed_artists'] = seed_artist_ids[:5]
            if seed_tracks:
                recommendation_params['seed_tracks'] = seed_tracks[:5]
            if target_features:
                recommendation_params.update(target_features)
            
            # 최소 하나의 시드는 필요
            if not seed_artist_ids and not seed_tracks:
                # 기본 K-pop 아티스트 사용
                default_artists = ['BTS', 'BLACKPINK', 'NewJeans']
                for artist_name in default_artists:
                    try:
                        search_result = sp.search(q=f'artist:{artist_name}', type='artist', limit=1)
                        if search_result['artists']['items']:
                            seed_artist_ids.append(search_result['artists']['items'][0]['id'])
                            break
                    except Exception as e:
                        print(f"기본 아티스트 검색 오류 ({artist_name}): {e}")
                        continue
                
                if seed_artist_ids:
                    recommendation_params['seed_artists'] = seed_artist_ids[:1]
            
            recommendations = sp.recommendations(**recommendation_params)
            
            # 추천 트랙들의 Audio Features 가져오기
            recommended_tracks = []
            track_ids = [track['id'] for track in recommendations['tracks']]
            
            try:
                audio_features_list = sp.audio_features(track_ids)
                
                for i, track in enumerate(recommendations['tracks']):
                    features = audio_features_list[i] if i < len(audio_features_list) else None
                    recommended_tracks.append({
                        'id': track['id'],
                        'name': track['name'],
                        'artist': track['artists'][0]['name'],
                        'uri': track['uri'],
                        'popularity': track['popularity'],
                        'features': features
                    })
            except Exception as e:
                print(f"추천 트랙 Audio Features 가져오기 오류: {e}")
                # Features 없이라도 트랙 정보는 반환
                for track in recommendations['tracks']:
                    recommended_tracks.append({
                        'id': track['id'],
                        'name': track['name'],
                        'artist': track['artists'][0]['name'],
                        'uri': track['uri'],
                        'popularity': track['popularity'],
                        'features': None
                    })
            
            return {
                'success': True,
                'tracks': recommended_tracks,
                'total_found': len(recommended_tracks)
            }
            
        except Exception as e:
            return {'success': False, 'error': str(e)}

    def analyze_playlist_features(self, token_info: dict, playlist_id: str) -> dict:
        """
        플레이리스트의 전체 Audio Features를 분석합니다.
        """
        sp = spotipy.Spotify(oauth_manager=self.sp_oauth)
        
        try:
            # 플레이리스트 트랙 가져오기
            results = sp.playlist_tracks(playlist_id)
            track_ids = [item['track']['id'] for item in results['items'] if item['track'] and item['track']['id']]
            
            if not track_ids:
                return {'success': False, 'error': 'No valid tracks found in playlist'}
            
            # Audio Features 가져오기
            audio_features_list = sp.audio_features(track_ids)
            
            # 평균값 계산
            features_sum = {}
            valid_count = 0
            
            for features in audio_features_list:
                if features:
                    valid_count += 1
                    for key, value in features.items():
                        if isinstance(value, (int, float)):
                            features_sum[key] = features_sum.get(key, 0) + value
            
            # 평균 계산
            avg_features = {}
            if valid_count > 0:
                for key, total in features_sum.items():
                    avg_features[key] = total / valid_count
            
            return {
                'success': True,
                'playlist_id': playlist_id,
                'track_count': len(track_ids),
                'analyzed_tracks': valid_count,
                'average_features': avg_features
            }
            
        except Exception as e:
            return {'success': False, 'error': str(e)}