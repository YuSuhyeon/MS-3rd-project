import React, { useState, useEffect } from "react";
import {
  Heart,
  MessageCircle,
  Eye,
  RefreshCw,
  Plus,
  Edit,
  Trash2,
  MoreHorizontal,
  Sparkles,
  Users,
  Clock,
} from "lucide-react";
import { motion, AnimatePresence } from "framer-motion";
import { useAuth } from "../context/AuthContext";
import LoginModal from "../components/community/LoginModal";
import PostModal from "../components/community/PostModal";
import {
  BackgroundEffect,
  NeonCard,
  GradientText,
  NeonButton,
  NeonScrollbarStyles,
} from "../components/ui/NeonTheme";

// 모바일 감지
const useMediaQuery = (query) => {
  const [matches, setMatches] = useState(false);

  useEffect(() => {
    const media = window.matchMedia(query);
    setMatches(media.matches);

    const listener = (e) => setMatches(e.matches);
    media.addEventListener("change", listener);

    return () => media.removeEventListener("change", listener);
  }, [query]);

  return matches;
};

const API_BASE_URL = "/api";
// API 함수들
const fetchPosts = async (page = 1, limit = 10) => {
  console.log(
    "🚀 API 호출 시도:",
    `${API_BASE_URL}/boards?page=${page}&limit=${limit}`
  );

  try {
    const token = localStorage.getItem("accessToken");
    const headers = { "Content-Type": "application/json" };
    if (token) {
      headers.Authorization = `Bearer ${token}`;
    }

    const response = await fetch(
      `${API_BASE_URL}/boards?page=${page}&limit=${limit}`,
      { headers }
    );

    if (!response.ok) {
      throw new Error(`네트워크 응답이 올바르지 않습니다: ${response.status}`);
    }

    const data = await response.json();
    return data.posts || data.data || data || [];
  } catch (error) {
    console.error("💥 게시글 가져오기 실패:", error);
    return [];
  }
};

const toggleLike = async (postId, isLiked) => {
  const token = localStorage.getItem("accessToken");
  if (!token) {
    throw new Error("로그인이 필요합니다.");
  }

  try {
    const method = isLiked ? "DELETE" : "POST";
    const response = await fetch(`${API_BASE_URL}/boards/${postId}/like`, {
      method,
      headers: {
        "Content-Type": "application/json",
        Authorization: `Bearer ${token}`,
      },
    });

    if (response.ok) {
      const data = await response.json();
      return data.likes_count;
    }
    throw new Error("좋아요 처리에 실패했습니다.");
  } catch (error) {
    console.error("좋아요 토글 실패:", error);
    throw error;
  }
};

const deletePost = async (postId) => {
  const token = localStorage.getItem("accessToken");
  if (!token) {
    throw new Error("로그인이 필요합니다.");
  }

  try {
    const response = await fetch(`${API_BASE_URL}/boards/${postId}`, {
      method: "DELETE",
      headers: { Authorization: `Bearer ${token}` },
    });

    if (!response.ok) {
      throw new Error("삭제에 실패했습니다.");
    }
    return true;
  } catch (error) {
    console.error("게시글 삭제 실패:", error);
    throw error;
  }
};

// 개별 게시글 컴포넌트
const SocialPost = ({
  post,
  onLikeUpdate,
  onPostUpdate,
  onPostDelete,
  currentUserId,
}) => {
  const [isLiked, setIsLiked] = useState(post.isLiked || false);
  const [likesCount, setLikesCount] = useState(post.likes_count || 0);
  const [isUpdating, setIsUpdating] = useState(false);
  const [showOptionsMenu, setShowOptionsMenu] = useState(false);
  const [showLoginModal, setShowLoginModal] = useState(false);
  const [showEditModal, setShowEditModal] = useState(false);
  const isOwner =
    currentUserId &&
    (post.user_id === currentUserId || post.user?.id === currentUserId);

  const handleLikeClick = async () => {
    if (!currentUserId) {
      setShowLoginModal(true);
      return;
    }

    if (isUpdating) return;

    setIsUpdating(true);
    try {
      const newLikesCount = await toggleLike(post.id || post.board_id, isLiked);
      const newLikedState = !isLiked;

      setIsLiked(newLikedState);
      setLikesCount(newLikesCount);
      onLikeUpdate &&
        onLikeUpdate(post.id || post.board_id, newLikesCount, newLikedState);
    } catch (error) {
      if (error.message === "로그인이 필요합니다.") {
        setShowLoginModal(true);
      }
    } finally {
      setIsUpdating(false);
    }
  };

  const handleDelete = async () => {
    if (window.confirm("정말로 이 게시글을 삭제하시겠습니까?")) {
      try {
        await deletePost(post.id || post.board_id);
        onPostDelete && onPostDelete(post.id || post.board_id);
      } catch (error) {
        alert("삭제에 실패했습니다.");
      }
    }
  };

  return (
    <NeonCard variant="primary" className="h-full">
      {/* 헤더 */}
      <div className="flex items-center justify-between mb-4">
        <div className="flex items-center gap-3">
          <img
            src={post.user_profile_image || "/img/default_profile_img.png"}
            alt="프로필"
            className="w-10 h-10 rounded-full border-2 border-purple-400"
            onError={(e) => {
              e.target.src = "/img/default_profile_img.png";
            }}
          />
          <div>
            <div className="flex items-center gap-2">
              <span className="font-bold text-white">
                {post.user_name || post.author || "익명"}
              </span>
              {isOwner && (
                <span className="px-2 py-1 bg-purple-500/20 text-purple-300 rounded-full text-xs">
                  내 글
                </span>
              )}
            </div>
            <div className="flex items-center gap-2 text-sm text-gray-400">
              <Clock className="w-3 h-3" />
              <span>
                {post.created_at
                  ? new Date(post.created_at).toLocaleDateString()
                  : "날짜 없음"}
              </span>
            </div>
          </div>
        </div>

        {/* 옵션 메뉴 (작성자만) */}
        {isOwner && (
          <div className="relative">
            <button
              onClick={() => setShowOptionsMenu(!showOptionsMenu)}
              className="p-2 text-gray-400 hover:text-white transition-colors rounded-lg hover:bg-white/10"
            >
              <MoreHorizontal className="w-5 h-5" />
            </button>

            <AnimatePresence>
              {showOptionsMenu && (
                <motion.div
                  initial={{ opacity: 0, scale: 0.95, y: -10 }}
                  animate={{ opacity: 1, scale: 1, y: 0 }}
                  exit={{ opacity: 0, scale: 0.95, y: -10 }}
                  className="absolute right-0 top-10 bg-gray-800 border border-gray-600 rounded-lg shadow-xl py-2 min-w-[120px] z-50"
                >
                  <button
                    onClick={() => {
                      setShowEditModal(true);
                      setShowOptionsMenu(false);
                    }}
                    className="w-full px-4 py-2 text-left text-sm text-gray-300 hover:bg-gray-700 flex items-center gap-2"
                  >
                    <Edit className="w-4 h-4" />
                    수정
                  </button>
                  <button
                    onClick={() => {
                      handleDelete();
                      setShowOptionsMenu(false);
                    }}
                    className="w-full px-4 py-2 text-left text-sm text-red-400 hover:bg-gray-700 flex items-center gap-2"
                  >
                    <Trash2 className="w-4 h-4" />
                    삭제
                  </button>
                </motion.div>
              )}
            </AnimatePresence>
          </div>
        )}
      </div>

      {/* 제목 */}
      {post.title && (
        <h3 className="text-lg font-bold text-white mb-3">{post.title}</h3>
      )}

      {/* 내용 */}
      <div className="mb-4">
        <p className="text-white/80 leading-relaxed">
          {post.content || "내용이 없습니다."}
        </p>
      </div>

      {/* 태그 */}
      {post.tags && (
        <div className="flex flex-wrap gap-2 mb-4">
          {(Array.isArray(post.tags) ? post.tags : post.tags.split(","))
            .slice(0, 3)
            .map((tag, tagIndex) => (
              <span
                key={tagIndex}
                className="px-2 py-1 bg-purple-500/20 text-purple-300 rounded-full text-xs border border-purple-400/30"
              >
                #{tag.trim()}
              </span>
            ))}
        </div>
      )}

      {/* 액션 버튼 */}
      <div className="flex items-center justify-between pt-4 border-t border-white/10">
        <div className="flex items-center gap-4">
          <button
            onClick={handleLikeClick}
            disabled={isUpdating}
            className={`flex items-center gap-2 px-3 py-2 rounded-lg transition-all ${
              isLiked
                ? "text-red-400 bg-red-500/10"
                : "text-gray-400 hover:text-red-400 hover:bg-red-500/10"
            } ${isUpdating ? "opacity-50" : ""}`}
          >
            <Heart className={`w-4 h-4 ${isLiked ? "fill-current" : ""}`} />
            <span className="text-sm">{likesCount}</span>
          </button>

          <button
            onClick={() => !currentUserId && setShowLoginModal(true)}
            className="flex items-center gap-2 px-3 py-2 rounded-lg text-gray-400 hover:text-blue-400 hover:bg-blue-500/10 transition-all"
          >
            <MessageCircle className="w-4 h-4" />
            <span className="text-sm">{post.comments_count || 0}</span>
          </button>
        </div>
      </div>

      {/* 모달들 */}
      <AnimatePresence>
        {showLoginModal && (
          <LoginModal onClose={() => setShowLoginModal(false)} />
        )}
        {showEditModal && (
          <PostModal
            mode="edit"
            post={post}
            onClose={() => setShowEditModal(false)}
            onSuccess={(updatedPost) => {
              onPostUpdate && onPostUpdate(updatedPost);
              setShowEditModal(false);
            }}
          />
        )}
      </AnimatePresence>

      {/* 옵션 메뉴 배경 클릭 감지 */}
      {showOptionsMenu && (
        <div
          className="fixed inset-0 z-40"
          onClick={() => setShowOptionsMenu(false)}
        />
      )}
    </NeonCard>
  );
};

// 메인 컴포넌트
export default function CommunitySocial() {
  const { profile } = useAuth();
  const isMobile = useMediaQuery("(max-width: 768px)");
  const [posts, setPosts] = useState([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState(null);
  const [apiStatus, setApiStatus] = useState("대기중");
  const [showLoginModal, setShowLoginModal] = useState(false);
  const [showPostModal, setShowPostModal] = useState(false);

  const currentUserId = profile?.sub || profile?.id || profile?.user_id;

  // 데이터 로드
  const loadPosts = async () => {
    console.log("🔧 백엔드 연결 테스트 시작...");
    setLoading(true);
    setError(null);
    setApiStatus("연결 중...");

    try {
      const data = await fetchPosts(1, 10);
      console.log("📊 받은 데이터:", data);
      setPosts(data);
      setApiStatus(`성공 - ${data.length}개 게시글`);

      if (data.length === 0) {
        setError("데이터가 비어있습니다. DB에 게시글이 있는지 확인하세요.");
      }
    } catch (error) {
      console.error("🚨 연결 테스트 실패:", error);
      setError(`연결 실패: ${error.message}`);
      setApiStatus("실패");
      setPosts([]);
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    loadPosts();
  }, []);

  // 로그인 상태 변화 감지하여 모달 닫기 - 추가
  useEffect(() => {
    if (profile && showLoginModal) {
      setShowLoginModal(false);
    }
  }, [profile, showLoginModal]);

  // 이벤트 핸들러들
  const handleCreatePostClick = () => {
    if (!profile) {
      setShowLoginModal(true);
    } else {
      setShowPostModal(true);
    }
  };

  const handleLikeUpdate = (postId, newLikesCount, isLiked) => {
    setPosts((prev) =>
      prev.map((post) =>
        post.id === postId || post.board_id === postId
          ? { ...post, likes_count: newLikesCount, isLiked }
          : post
      )
    );
  };

  const handlePostUpdate = (updatedPost) => {
    setPosts((prev) =>
      prev.map((post) =>
        post.id === updatedPost.id || post.board_id === updatedPost.id
          ? { ...post, ...updatedPost }
          : post
      )
    );
  };

  const handlePostDelete = (postId) => {
    setPosts((prev) =>
      prev.filter((post) => post.id !== postId && post.board_id !== postId)
    );
  };

  const handlePostCreate = (newPost) => {
    loadPosts(); // 글 작성 완료되면 새로고침
  };

  if (loading && posts.length === 0) {
    return (
      <div className="flex items-center justify-center h-screen bg-gradient-to-br from-purple-900 via-black to-pink-900">
        <motion.div
          animate={{ rotate: 360 }}
          transition={{ duration: 2, repeat: Infinity, ease: "linear" }}
          className="w-12 h-12 border-4 border-purple-400 border-t-pink-400 rounded-full"
        />
        <span className="ml-4 text-white text-lg">소셜 피드 로딩 중...</span>
      </div>
    );
  }

  return (
    <BackgroundEffect className="flex-1 min-h-screen neon-scrollbar overflow-y-auto">
      <NeonScrollbarStyles />

      {/* 배경 효과 */}
      <div className="absolute inset-0 pointer-events-none">
        <div className="bg-gradient-to-br from-purple-900/30 via-black/50 to-pink-900/30 absolute inset-0" />
        {[...Array(15)].map((_, i) => (
          <motion.div
            key={i}
            className="absolute w-1 h-1 bg-white rounded-full opacity-30"
            style={{
              left: `${Math.random() * 100}%`,
              top: `${Math.random() * 100}%`,
            }}
            animate={{
              opacity: [0, 1, 0],
              scale: [0, 1, 0],
            }}
            transition={{
              duration: 3 + Math.random() * 2,
              repeat: Infinity,
              delay: Math.random() * 2,
            }}
          />
        ))}
      </div>

      {/* 메인 콘텐츠 */}
      <div className="relative z-10 p-6">
        {/* 헤더 */}
        <motion.header
          className="mb-8"
          initial={{ opacity: 0, y: -20 }}
          animate={{ opacity: 1, y: 0 }}
          transition={{ duration: 0.8 }}
        >
          <div className="flex items-center justify-between mb-6">
            <div>
              <GradientText variant="primary" size="4xl" className="block mb-2">
                ✨ 소셜 피드
              </GradientText>
              <p className="text-white/70 text-lg">
                K-Pop과 함께하는 여행 이야기를 공유해보세요
              </p>
            </div>

            <div className="flex items-center gap-3">
              {/* 글 작성 버튼 */}
              <NeonButton
                onClick={handleCreatePostClick}
                variant="primary"
                size="md"
              >
                <Plus className="w-4 h-4 mr-2" />글 작성
              </NeonButton>

              {/* 새로고침 버튼 */}
              <NeonButton
                onClick={loadPosts}
                disabled={loading}
                variant="secondary"
                size="md"
              >
                <RefreshCw
                  className={`w-4 h-4 ${loading ? "animate-spin" : ""}`}
                />
              </NeonButton>
            </div>
          </div>

          {/* 사용자 프로필 표시 */}
          {profile && (
            <div className="flex items-center gap-3 bg-white/5 backdrop-blur-sm rounded-xl px-4 py-3 border border-white/20 mb-6">
              <img
                src={profile.picture || "/img/default_profile_img.png"}
                alt={profile.name}
                className="w-10 h-10 rounded-full border-2 border-purple-400"
              />
              <div>
                <span className="text-white font-medium">
                  {profile.name}님, 환영합니다!
                </span>
                <p className="text-white/60 text-sm">
                  오늘은 어떤 이야기를 들려주실 건가요?
                </p>
              </div>
            </div>
          )}

          {/* 로그인하지 않은 사용자 안내 */}
          {!profile && (
            <NeonCard variant="info" delay={0.3} className="mb-6">
              <div className="flex items-center gap-3">
                <Sparkles className="w-5 h-5 text-blue-400" />
                <div className="flex-1">
                  <p className="text-white font-medium">
                    좋아요, 댓글, 글 작성을 하려면 로그인이 필요합니다.
                  </p>
                  <p className="text-white/70 text-sm mt-1">
                    조회는 자유롭게 가능합니다!
                  </p>
                </div>
                <NeonButton
                  onClick={() => setShowLoginModal(true)}
                  variant="primary"
                  size="sm"
                >
                  로그인
                </NeonButton>
              </div>
            </NeonCard>
          )}
        </motion.header>

        {/* 게시글 목록 */}
        <motion.section
          initial={{ opacity: 0 }}
          animate={{ opacity: 1 }}
          transition={{ delay: 0.6, duration: 0.8 }}
        >
          {posts.length === 0 ? (
            <NeonCard
              variant="warning"
              className="text-center py-12"
              delay={0.8}
            >
              <Sparkles className="w-16 h-16 mx-auto mb-6 text-yellow-400" />
              <GradientText variant="warning" size="2xl" className="block mb-4">
                아직 게시글이 없습니다
              </GradientText>
              <p className="text-white/70 mb-6">
                {profile
                  ? "첫 번째 게시글을 작성해보세요!"
                  : "로그인하여 첫 번째 게시글을 작성해보세요!"}
              </p>
              <NeonButton
                onClick={handleCreatePostClick}
                variant="primary"
                size="lg"
              >
                <Plus className="w-5 h-5 mr-2" />
                {profile ? "첫 번째 게시글 작성하기" : "로그인하여 글 작성하기"}
              </NeonButton>
            </NeonCard>
          ) : (
            <div className="grid gap-6 grid-cols-1 lg:grid-cols-2 xl:grid-cols-3">
              {posts.map((post, index) => (
                <motion.div
                  key={post.id || post.board_id || index}
                  initial={{ opacity: 0, y: 20 }}
                  animate={{ opacity: 1, y: 0 }}
                  transition={{ delay: 0.8 + index * 0.05, duration: 0.4 }}
                >
                  <SocialPost
                    post={post}
                    onLikeUpdate={handleLikeUpdate}
                    onPostUpdate={handlePostUpdate}
                    onPostDelete={handlePostDelete}
                    currentUserId={currentUserId}
                  />
                </motion.div>
              ))}
            </div>
          )}
        </motion.section>
      </div>

      {/* 모달들 */}
      <AnimatePresence>
        {showLoginModal && (
          <LoginModal onClose={() => setShowLoginModal(false)} />
        )}
        {showPostModal && (
          <PostModal
            mode="create"
            onClose={() => setShowPostModal(false)}
            onSuccess={handlePostCreate}
          />
        )}
      </AnimatePresence>
    </BackgroundEffect>
  );
}
