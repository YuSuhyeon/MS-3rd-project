import React, { useState, useEffect } from "react";
import { Link, useLocation } from "react-router-dom";
import BrandLogo from "components/BrandLogo";
import { useAuth } from "context/AuthContext";
import {
  LogOut,
  LogIn,
  DollarSign,
  ChevronUp,
  ChevronDown,
  Sun,
  Cloud,
  CloudRain,
  TrendingUp,
  TrendingDown,
  RefreshCw,
  Droplets,
  Wind,
} from "lucide-react";

const navigationItems = [
  // { title: "페르소나 분석", url: "/persona", icon: null },
  // { title: "결과 대시보드", url: "/result", icon: null },
  // { title: "일정 플래너", url: "/itinerary", icon: null },
  // { title: "경로 편집", url: "/directions", icon: null },
  // { title: "AI 도슨트", url: "/docent", icon: null },
  // { title: "커뮤니티", url: "/community", icon: null },
  // { title: "VisionOcr", url: "/visionocr", icon: null, exact: true },
  // { title: "AI 사진인식", url: "/vision", icon: null, exact: true },
  { title: "Persona Analysis", url: "/persona" },
  { title: "Result Dashboard", url: "/result" },
  { title: "Itinerary Planner", url: "/itinerary" },
  { title: "Edit Route", url: "/directions" },
  { title: "AI Docent", url: "/docent" },
  { title: "Community", url: "/community" },
  { title: "Vision OCR", url: "/visionocr", exact: true },
  { title: "AI Vision", url: "/vision", exact: true },
];

// API 호출 함수들
const callExchangeRateAPI = async () => {
  const functionUrl =
    "https://team03-function-cce6cugxacd3aqcs.eastus-01.azurewebsites.net/api/ExchangeRateAPI";
  try {
    const response = await fetch(functionUrl, {
      method: "GET",
      headers: { "Content-Type": "application/json" },
    });
    if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);
    return await response.json();
  } catch (error) {
    console.error("환율 API 호출 오류:", error);
  }
};

const callWeatherAPI = async () => {
  const functionUrl =
    "https://team03-function-cce6cugxacd3aqcs.eastus-01.azurewebsites.net/api/WeatherAPI?";
  try {
    const response = await fetch(functionUrl, {
      method: "GET",
      headers: { "Content-Type": "application/json" },
    });
    if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);
    return await response.json();
  } catch (error) {
    console.error("날씨 API 호출 오류:", error);
  }
};

// 실시간 환율 및 날씨 위젯
const LiveInfoWidget = ({ isCollapsed, onToggle }) => {
  const [exchangeData, setExchangeData] = useState({
    USD: { rate: 1300.5, change: 0 },
    CNY: { rate: 178.9, change: 0 },
    JPY: { rate: 8.7, change: 0 },
  });

  const fetchExchangeData = async () => {
    try {
      const result = await callExchangeRateAPI();
      setExchangeData((prev) => ({
        USD: {
          rate: result.USD?.rate || prev.USD.rate,
          change: (Math.random() - 0.5) * 0.5,
        },
        CNY: {
          rate: result.CNY?.rate || prev.CNY.rate,
          change: (Math.random() - 0.5) * 0.3,
        },
        JPY: {
          rate: result.JPY?.rate || prev.JPY.rate,
          change: (Math.random() - 0.5) * 0.2,
        },
      }));
    } catch (error) {
      console.error("환율 데이터 로딩 실패:", error);
    }
  };

  useEffect(() => {
    fetchExchangeData();
    const interval = setInterval(fetchExchangeData, 2000);
    return () => clearInterval(interval);
  }, []);

  const fetchWeatherData = async () => {
    setLoading(true);
    try {
      const weather = await callWeatherAPI();
      setWeatherData(weather);
    } catch (error) {
      console.error("날씨 데이터 로딩 실패:", error);
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    fetchWeatherData();
    const interval = setInterval(fetchWeatherData, 5000);
    return () => clearInterval(interval);
  }, []);

  const getWeatherIcon = (condition) => {
    switch (condition?.toLowerCase()) {
      case "sunny":
      case "clear":
        return <Sun className="w-4 h-4 text-yellow-500" />;
      case "cloudy":
      case "overcast":
        return <Cloud className="w-4 h-4 text-gray-500" />;
      case "rain":
      case "rainy":
        return <CloudRain className="w-4 h-4 text-blue-500" />;
      default:
        return <Sun className="w-4 h-4 text-yellow-500" />;
    }
  };

  const formatRate = (rate) =>
    typeof rate === "number" ? rate.toFixed(1) : rate;
  const getChangeColor = (change) =>
    change > 0
      ? "text-green-600"
      : change < 0
      ? "text-red-600"
      : "text-gray-500";
  const getChangeIcon = (change) =>
    change > 0 ? (
      <TrendingUp className="w-3 h-3" />
    ) : change < 0 ? (
      <TrendingDown className="w-3 h-3" />
    ) : null;

  return (
    <div className="border-t border-gray-200/50 bg-gradient-to-r from-blue-50 to-purple-50">
      <button
        onClick={onToggle}
        className="w-full px-4 py-3 flex items-center justify-between hover:bg-white/30 transition-colors"
      >
        <div className="flex items-center gap-2">
          <DollarSign className="w-4 h-4 text-blue-600" />
          <span className="text-sm font-medium text-gray-700">실시간 정보</span>
        </div>
        {/* 아이콘 로직 변경: 펼쳐져 있을 때 아래 화살표(ChevronDown) 표시 */}
        {isCollapsed ? (
          <ChevronUp className="w-4 h-4 text-gray-500" />
        ) : (
          <ChevronDown className="w-4 h-4 text-gray-500" />
        )}
      </button>

      {!isCollapsed && (
        <div className="px-4 pb-4 space-y-4">
          <div>
            <div className="text-xs font-medium text-gray-600 mb-2">
              환율 (KRW)
            </div>
            <div className="space-y-2">
              {Object.entries(exchangeData).map(([currency, data]) => (
                <div
                  key={currency}
                  className="flex items-center justify-between text-xs"
                >
                  <span className="font-medium text-gray-700">{currency}</span>
                  <div className="flex items-center gap-1">
                    <span className="font-mono text-gray-800">
                      {formatRate(data.rate)}
                    </span>
                    <div
                      className={`flex items-center gap-1 ${getChangeColor(
                        data.change
                      )}`}
                    >
                      {getChangeIcon(data.change)}
                      <span className="font-mono">
                        {Math.abs(data.change).toFixed(1)}%
                      </span>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
          <div>
            <div className="flex items-center justify-between mb-2">
              <span className="text-xs font-medium text-gray-600">
                서울 날씨
              </span>
              <button
                onClick={fetchWeatherData}
                disabled={loading}
                className="p-1 hover:bg-white/50 rounded transition-colors disabled:opacity-50"
              >
                <RefreshCw
                  className={`w-3 h-3 text-gray-500 ${
                    loading ? "animate-spin" : ""
                  }`}
                />
              </button>
            </div>
            {/* weatherData가 항상 객체이므로 조건부 렌더링 제거 */}
            <div className="space-y-2">
              <div className="flex items-center justify-between text-xs">
                <div className="flex items-center gap-1">
                  {getWeatherIcon(weatherData.condition)}
                  <span className="text-gray-700">온도</span>
                </div>
                <span className="font-mono text-gray-800">
                  {weatherData.temperature}°C
                </span>
              </div>
              {weatherData.humidity && (
                <div className="flex items-center justify-between text-xs">
                  <div className="flex items-center gap-1">
                    <Droplets className="w-3 h-3 text-blue-500" />
                    <span className="text-gray-700">습도</span>
                  </div>
                  <span className="font-mono text-gray-800">
                    {weatherData.humidity}%
                  </span>
                </div>
              )}
              {weatherData.wind && (
                <div className="flex items-center justify-between text-xs">
                  <div className="flex items-center gap-1">
                    <Wind className="w-3 h-3 text-gray-500" />
                    <span className="text-gray-700">바람</span>
                  </div>
                  <span className="font-mono text-gray-800">
                    {weatherData.wind}m/s
                  </span>
                </div>
              )}
            </div>
          </div>
        </div>
      )}
    </div>
  );
};

export default function Layout({ children }) {
  const location = useLocation();
  const { profile, login, logout } = useAuth();
  const [menuOpen, setMenuOpen] = useState(false);

  const [isLiveInfoCollapsed, setIsLiveInfoCollapsed] = useState(false);

  const toggleLiveInfo = () => {
    setIsLiveInfoCollapsed((prevState) => !prevState);
  };

  const isActive = (path, exact) => {
    if (exact) return location.pathname === path;
    return (
      location.pathname === path || location.pathname.startsWith(path + "/")
    );
  };

  return (
    <div className="min-h-screen flex w-full bg-gradient-to-br from-pink-50 via-purple-50 to-indigo-50">
      <aside
        className={`fixed inset-y-0 left-0 z-50 w-72 bg-white/80 backdrop-blur-sm border-r border-white/20 flex flex-col transform transition-transform duration-200 ${
          menuOpen ? "translate-x-0" : "-translate-x-full"
        } md:static md:translate-x-0`}
      >
        {/* Header */}
        <div className="border-b border-gray-200/50 p-6">
          <Link
            to="/"
            className="flex items-center gap-3 hover:opacity-95 transition-opacity"
            onClick={() => setMenuOpen(false)}
          >
            <div className="w-10 h-10 rounded-xl flex items-center justify-center shadow-lg">
              <BrandLogo size={40} />
            </div>
            <div>
              <h2 className="font-bold text-gray-900 text-lg">
                AI 여행 플래너
              </h2>
              <p className="text-xs text-gray-500">맞춤형 여행 계획 서비스</p>
            </div>
          </Link>
        </div>

        {/* Menu */}
        <div className="p-3 flex-1 overflow-y-auto">
          <div className="text-xs font-medium text-gray-500 uppercase tracking-wider px-3 py-2">
            메뉴
          </div>
          <nav className="px-2">
            {navigationItems.map((item) => {
              const active = isActive(item.url, item.exact);
              return (
                <Link
                  key={item.title}
                  to={item.url}
                  onClick={() => setMenuOpen(false)}
                  className={`flex items-center gap-3 px-4 py-3 rounded-xl transition-all duration-200 mb-1 hover:bg-pink-50 hover:text-pink-700 ${
                    active
                      ? "bg-gradient-to-r from-pink-500 to-purple-600 text-white shadow-lg"
                      : ""
                  }`}
                >
                  <span className="font-medium">{item.title}</span>
                </Link>
              );
            })}
          </nav>
        </div>

        {/* Footer Area */}
        <div className="mt-auto">
          {/* 실시간 정보 위젯 */}
          <LiveInfoWidget
            isCollapsed={isLiveInfoCollapsed}
            onToggle={toggleLiveInfo}
          />

          {/* 프로필 섹션 */}
          <div className="border-t border-gray-200/50 p-6">
            {profile ? (
              <div className="flex items-center gap-3">
                <img
                  src={profile.picture}
                  alt={profile.name}
                  className="w-8 h-8 rounded-full"
                />
                <div className="flex-1 min-w-0">
                  <p className="font-medium text-gray-900 text-sm truncate">
                    {profile.name}
                  </p>
                  <p className="text-xs text-gray-500 truncate">
                    {profile.email}
                  </p>
                </div>
                <button
                  onClick={logout}
                  title="로그아웃"
                  className="p-2 rounded-md text-gray-500 hover:bg-gray-100 hover:text-gray-800 transition-colors"
                >
                  <LogOut size={18} />
                </button>
              </div>
            ) : (
              <div className="flex items-center gap-3">
                <div className="w-8 h-8 bg-gray-200 rounded-full flex items-center justify-center">
                  <span className="text-gray-500 font-medium text-sm">?</span>
                </div>
                <div className="flex-1 min-w-0">
                  <p className="font-medium text-gray-900 text-sm truncate">
                    여행자님, 환영합니다!
                  </p>
                  <p className="text-xs text-gray-500 truncate">
                    AI와 함께 여행 계획
                  </p>
                </div>
                <button
                  onClick={() => login()}
                  title="로그인"
                  className="p-2 rounded-md text-gray-500 hover:bg-gray-100 hover:text-gray-800 transition-colors"
                >
                  <LogIn size={18} />
                </button>
              </div>
            )}
          </div>
        </div>
      </aside>

      {/* Mobile Overlay */}
      {menuOpen && (
        <button
          className="fixed inset-0 z-40 bg-black/30 md:hidden"
          aria-label="사이드바 닫기"
          onClick={() => setMenuOpen(false)}
        />
      )}

      {/* Main Content */}
      <main className="flex-1 flex flex-col">
        <header className="bg-white/80 backdrop-blur-md border-b border-white/20 px-6 py-4 md:hidden sticky top-0 z-50">
          <div className="flex items-center gap-4">
            <button
              className="hover:bg-gray-100 p-2 rounded-lg transition-colors duration-200"
              aria-label="메뉴"
              onClick={() => setMenuOpen((v) => !v)}
            >
              <svg width="20" height="20" viewBox="0 0 20 20">
                <path
                  d="M3 6h14M3 10h14M3 14h14"
                  stroke="#444"
                  strokeWidth="1.5"
                  strokeLinecap="round"
                />
              </svg>
            </button>
            <h1 className="text-xl font-semibold">AI 여행 플래너</h1>
          </div>
        </header>
        <div className="flex-1 overflow-auto">
          <div className="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-6">
            {children}
          </div>
        </div>
      </main>
    </div>
  );
}
